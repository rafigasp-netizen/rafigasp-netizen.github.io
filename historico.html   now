<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<title>HISTORICO 1/2 1/3 2/3</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial Black}
body{background:#000;display:flex;justify-content:center}
#app{width:98%;max-width:400px;background:#0a2e1e;min-height:100dvh;padding:4px;display:flex;flex-direction:column;gap:6px}
.topo{background:#ffcc00;text-align:center;padding:12px;font-size:14px;border-radius:6px}
.info{background:#001a8a;color:#fff;text-align:center;padding:10px;border-radius:6px;font-size:12px;line-height:16px}
.info span{color:#ffcc00}
.linha{background:#0a3d1f;border-radius:8px;padding:8px;border:1px solid #1a5a2e}
.linha h3{color:#ffcc00;font-size:13px;margin-bottom:5px}
.faixa{display:flex;gap:4px;overflow-x:auto;min-height:34px;padding:4px 0}
.q{width:34px;height:30px;border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff;border:1.5px solid #fff}
.q.C{background:#00a000}
.q.E{background:#c00000}
.placar{background:#000;color:#fff;border-radius:6px;padding:6px;text-align:center;font-size:11px;margin-top:5px}
.placar b{color:#ffcc00}
.grid{margin-top:4px;background:#0a3d1f;border-radius:8px;padding:4px;display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
.cell{border:1.5px solid #d4af37;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:20px;min-height:44px}
.cell.red{background:#b50000}
.cell.black{background:#111}
.btns{display:flex;gap:4px}
.btns button{flex:1;padding:12px;border:0;border-radius:6px;font-weight:900;background:#ffcc00}
.voltar{background:#222;color:#fff;text-align:center;padding:10px;border-radius:6px;font-size:11px;text-decoration:none;display:block}
</style>
</head>
<body>
<div id="app">
<div class="topo">HISTÓRICO 1/2 - 1/3 - 2/3</div>
<div class="info" id="info">Clique no 1º número da roleta abaixo...</div>

<div class="linha"><h3>1/2 (3ª Coluna)</h3><div class="faixa" id="f12"></div><div class="placar" id="p12">0 ACERTOS</div></div>
<div class="linha"><h3>1/3 (2ª Coluna)</h3><div class="faixa" id="f13"></div><div class="placar" id="p13">0 ACERTOS</div></div>
<div class="linha"><h3>2/3 (1ª Coluna)</h3><div class="faixa" id="f23"></div><div class="placar" id="p23">0 ACERTOS</div></div>

<div class="grid" id="grid"></div>
<div class="placar" id="geral">GERAL: 0 X 0</div>
<div class="btns"><button onclick="corrigir()">CORRIGIR</button><button onclick="if(confirm('Zerar tudo?')){localStorage.removeItem('hist123');localStorage.removeItem('ultimo123');location.reload()}">LIMPAR</button></div>
<a class="voltar" href="index.html">← VOLTAR</a>
</div>

<script>
const COL={0:0,1:1,2:2,3:3,4:1,5:2,6:3,7:1,8:2,9:3,10:1,11:2,12:3,13:1,14:2,15:3,16:1,17:2,18:3,19:1,20:2,21:3,22:1,23:2,24:3,25:1,26:2,27:3,28:1,29:2,30:3,31:1,32:2,33:3,34:1,35:2,36:3};
const TAB={0:"ZERO",1:"2/3",2:"1/3",3:"1/2",4:"2/3",5:"1/3",6:"1/2",7:"2/3",8:"1/3",9:"1/2",10:"2/3",11:"1/3",12:"1/2",13:"2/3",14:"1/3",15:"1/2",16:"2/3",17:"1/3",18:"1/2",19:"2/3",20:"1/3",21:"1/2",22:"2/3",23:"1/3",24:"1/2",25:"2/3",26:"1/3",27:"1/2",28:"2/3",29:"1/3",30:"1/2",31:"2/3",32:"1/3",33:"1/2",34:"2/3",35:"1/3",36:"1/2"};
const REDS=[1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36];
let hist=JSON.parse(localStorage.getItem('hist123')||'[]');
let ultimo=localStorage.getItem('ultimo123')?parseInt(localStorage.getItem('ultimo123')):null;
let grid=document.getElementById('grid');
for(let i=1;i<=36;i++){let d=document.createElement('div');d.className='cell '+(REDS.includes(i)?'red':'black');d.textContent=i;d.onclick=()=>add(i);grid.appendChild(d);}

function render(){
 let f12=document.getElementById('f12'), f13=document.getElementById('f13'), f23=document.getElementById('f23');
 f12.innerHTML=""; f13.innerHTML=""; f23.innerHTML="";
 let c12={a:0,e:0}, c13={a:0,e:0}, c23={a:0,e:0};
 hist.forEach(h=>{
   let q=document.createElement('div'); q.className='q '+(h.ok?'C':'E'); q.textContent=h.ok?'🟩':'🟥';
   if(h.tab==='1/2'){f12.appendChild(q); h.ok?c12.a++:c12.e++}
   if(h.tab==='1/3'){f13.appendChild(q); h.ok?c13.a++:c13.e++}
   if(h.tab==='2/3'){f23.appendChild(q); h.ok?c23.a++:c23.e++}
 });
 document.getElementById('p12').innerHTML=`<b>1/2</b> ${c12.a} X ${c12.e} - ${(c12.a/(c12.a+c12.e||1)*100).toFixed(1)}%`;
 document.getElementById('p13').innerHTML=`<b>1/3</b> ${c13.a} X ${c13.e} - ${(c13.a/(c13.a+c13.e||1)*100).toFixed(1)}%`;
 document.getElementById('p23').innerHTML=`<b>2/3</b> ${c23.a} X ${c23.e} - ${(c23.a/(c23.a+c23.e||1)*100).toFixed(1)}%`;
 document.getElementById('geral').innerHTML=`GERAL: <b>${c12.a+c13.a+c23.a} ACERTOS X ${c12.e+c13.e+c23.e} ERROS</b>`;
 if(ultimo!==null){
   if(hist.length){
     let u=hist[0]; document.getElementById('info').innerHTML=`Último: <span>${u.prev} > ${u.tab}</span> → ${u.curr} = <span style="color:${u.ok?'#0f0':'#f00'}">${u.ok?'🟩 ACERTOU':'🟥 ERROU'}</span> | Próximo: <span>${u.curr} > ${TAB[u.curr]}</span>`;
   } else {
     document.getElementById('info').innerHTML=`Primeiro: <span>${ultimo} > ${TAB[ultimo]}</span> | Aguardando próximo número...`;
   }
 }
}
render();

function add(num){
 if(ultimo===null){ ultimo=num; localStorage.setItem('ultimo123',num); render(); return; }
 let tab=TAB[ultimo];
 if(tab==="ZERO"){ ultimo=num; localStorage.setItem('ultimo123',num); render(); return; }
 let ok = COL[num] === COL[ultimo];
 hist.unshift({prev:ultimo, tab:tab, curr:num, ok:ok});
 ultimo=num;
 localStorage.setItem('hist123',JSON.stringify(hist));
 localStorage.setItem('ultimo123',num);
 render();
}

function corrigir(){ if(hist.length){ hist.shift(); localStorage.setItem('hist123',JSON.stringify(hist)); render(); } }
</script>
</body>
</html>
