<!DOCTYPE html><html lang="pt"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RAFIGASP</title><style>*{box-sizing:border-box}html,body{margin:0;background:#0a1f13;height:100%}body{display:flex;justify-content:center}.app{width:100%;max-width:420px;min-height:100vh;background:#0d291a;border:3px solid #c9a84c;display:flex;flex-direction:column;font-family:Arial Black}.h{background:linear-gradient(#e9c86a,#c9a84c);text-align:center;padding:14px;font-size:26px;border-radius:12px;margin:4px}.s{color:#c9a84c;text-align:center;font-size:10px;letter-spacing:4px;padding:6px}.top{display:flex;gap:6px;padding:6px}.b{flex:1;background:#000;color:#e9c86a;text-align:center;padding:14px;border-radius:12px;font-size:22px;border:1px solid #c9a84c}.tr{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;padding:8px}.n{height:46px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:22px}.y{background:#f1c84a;color:#000}.r{background:#d31f1f;color:#fff}.g{background:#18a05e;color:#fff}.e{background:#08140e;border:1px dashed #2a3d30}.kb{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px;margin-top:auto}.k{background:linear-gradient(#d4b86a,#b9974a);border-radius:14px;padding:20px 0;text-align:center;font-size:30px}.k.s2{font-size:14px}.k.z{background:linear-gradient(#ff3b3b,#b91c1c);color:#fff}</style></head><body><div class="app"><div class="h">RAFIGASP</div><div class="s">COACH DA ROLETA</div><div class="top"><div class="b" id="last">-</div><div class="b" id="col">AGUARDANDO</div></div><div class="tr"><div class="n e" id="p0"></div><div class="n e" id="p1"></div><div class="n e" id="p2"></div><div class="n e" id="p3"></div><div class="n e" id="p4"></div><div class="n e" id="p5"></div><div class="n e" id="p6"></div><div class="n e" id="p7"></div><div class="n e" id="p8"></div><div class="n e" id="p9"></div><div class="n e" id="p10"></div><div class="n e" id="p11"></div></div><div class="kb"><div class="k" onclick="A('1')">1</div><div class="k" onclick="A('2')">2</div><div class="k" onclick="A('3')">3</div><div class="k" onclick="A('4')">4</div><div class="k" onclick="A('5')">5</div><div class="k" onclick="A('6')">6</div><div class="k" onclick="A('7')">7</div><div class="k" onclick="A('8')">8</div><div class="k" onclick="A('9')">9</div><div class="k s2" onclick="E()">ENTER</div><div class="k z" onclick="A('0')">0</div><div class="k s2" onclick="C()">CORRIGIR</div></div></div><script>let cur='',hist=[];let slots=[p0,p1,p2,p3,p4,p5,p6,p7,p8,p9,p10,p11];function getCol(v){if(v===0)return 0;return ((v-1)%3)+1;}function A(d){if(cur.length<2)cur+=d;}function E(){if(!cur)return;let v=parseInt(cur);if(v===0){hist=[];last.innerText='-';col.innerText='AGUARDANDO';cur='';render();return;}hist.push(v);last.innerText=v;col.innerText='COLUNA '+getCol(v);cur='';render();}function C(){if(cur!==''){cur='';return;}hist.pop();render();if(hist.length){let lv=hist[hist.length-1];last.innerText=lv;col.innerText='COLUNA '+getCol(lv);}else{last.innerText='-';col.innerText='AGUARDANDO';}}function render(){slots.forEach((el,i)=>{let v=hist[i];if(v===undefined){el.innerText='';el.className='n e';return;}el.innerText=v;if(i%4===0){el.className='n y';return;}let base=hist[Math.floor(i/4)*4];if(getCol(v)===getCol(base)){el.className='n g';}else{el.className='n r';}});}</script></body></html>
